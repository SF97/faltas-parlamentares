---
import Base from "../layouts/Base.astro";
import deputados from "../data/deputados.json";
import meta from "../data/meta.json";
import { base } from "../lib/base";

import AbsenceNote from "../components/AbsenceNote.astro";
import { absencePercentage, formatAbsencePercentage, unavailableExplanation } from "../lib/absence";

type Row = (typeof deputados)[number];

type Sessao = { estado: string; motivo: string | null };
type DeputadoDetail = { bid: number; totais: Record<string, number>; sessoes: Sessao[] };

const slugify = (s: string): string =>
	s
		.normalize("NFD")
		.replace(/[\u0300-\u036f]/g, "")
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/(^-|-$)/g, "");

const detailFiles = import.meta.glob<{ default: DeputadoDetail }>("../data/deputado/*.json", { eager: true });
const statusByBid = new Map(Object.values(detailFiles).map(({ default: d }) => [d.bid, d.totais]));
const percentageFor = (list: Row[]) => absencePercentage(list.map((d) => statusByBid.get(d.bid) ?? {}));
const motivoCounts = new Map<string, number>();
const fCountsByBid = new Map<number, number>();
for (const mod of Object.values(detailFiles)) {
	const f = mod.default.totais?.F ?? 0;
	if (f > 0) fCountsByBid.set(mod.default.bid, f);
	for (const s of mod.default.sessoes) {
		if (s.estado !== "FJ" || !s.motivo) continue;
		motivoCounts.set(s.motivo, (motivoCounts.get(s.motivo) ?? 0) + 1);
	}
}
const topMotivos = Array.from(motivoCounts.entries())
	.map(([motivo, n]) => ({ motivo, n, slug: slugify(motivo) }))
	.sort((a, b) => b.n - a.n)
	.slice(0, 5);

const parties = Array.from(new Set(deputados.map((d: Row) => d.gp))).sort();

const byParty = (list: Row[]) => {
	const m = new Map<string, { gp: string; deputados: number; fi: number; fj: number; f: number; amp: number; total: number }>();
	for (const d of list) {
		const e = m.get(d.gp) ?? { gp: d.gp, deputados: 0, fi: 0, fj: 0, f: 0, amp: 0, total: 0 };
		e.deputados++;
		e.fi += d.faltas_injustificadas;
		e.fj += d.faltas_justificadas;
		e.f += fCountsByBid.get(d.bid) ?? 0;
		e.amp += d.missao_parlamentar;
		e.total += d.total_reunioes;
		m.set(d.gp, e);
	}
	return Array.from(m.values()).map((p) => ({ ...p, percentage: percentageFor(list.filter((d) => d.gp === p.gp)) })).sort((a, b) => b.fi - a.fi);
};

const totals = {
	deputados: deputados.length,
	percentage: percentageFor(deputados),
	fi: deputados.reduce((a, d) => a + d.faltas_injustificadas, 0),
	fj: deputados.reduce((a, d) => a + d.faltas_justificadas, 0),
	amp: deputados.reduce((a, d) => a + d.missao_parlamentar, 0),
	f: Array.from(fCountsByBid.values()).reduce((a, n) => a + n, 0),
};

const ranked = deputados
	.map((d) => ({ ...d, f: fCountsByBid.get(d.bid) ?? 0, percentage: percentageFor([d]) }))
	.sort((a, b) => {
		if (b.faltas_injustificadas !== a.faltas_injustificadas) return b.faltas_injustificadas - a.faltas_injustificadas;
		if (b.faltas_justificadas !== a.faltas_justificadas) return b.faltas_justificadas - a.faltas_justificadas;
		if (b.f !== a.f) return b.f - a.f;
		return a.nome.localeCompare(b.nome, "pt-PT");
	});

const fqv = deputados
	.filter((d) => d.falta_quorum_votacao > 0)
	.sort((a, b) => b.falta_quorum_votacao - a.falta_quorum_votacao || a.nome.localeCompare(b.nome, "pt-PT"));
---

<script>
  document.querySelectorAll("table.sortable").forEach((table) => {
    const headers = table.querySelectorAll("thead th");
    const tbody = table.querySelector("tbody");

    headers.forEach((header, columnIndex) => {
      header.style.cursor = "pointer";

      header.addEventListener("click", () => {
        const type = header.dataset.sort || "text";
        const ascending = header.dataset.order !== "asc";

        // Reset sort state on other headers
        headers.forEach((h) => delete h.dataset.order);

        header.dataset.order = ascending ? "asc" : "desc";

        const rows = [...tbody.querySelectorAll("tr")];

        rows.sort((a, b) => {
          if (type === "percentage") {
            const aRaw = a.cells[columnIndex]?.dataset.sortValue ?? "";
            const bRaw = b.cells[columnIndex]?.dataset.sortValue ?? "";
            if (aRaw === "" || bRaw === "") return aRaw === bRaw ? 0 : aRaw === "" ? 1 : -1;
            return ascending ? Number(aRaw) - Number(bRaw) : Number(bRaw) - Number(aRaw);
          }

          let aValue = a.cells[columnIndex]?.textContent.trim() ?? "";
          let bValue = b.cells[columnIndex]?.textContent.trim() ?? "";

          if (type === "number") {
            aValue = parseFloat(aValue) || 0;
            bValue = parseFloat(bValue) || 0;

            return ascending
              ? aValue - bValue
              : bValue - aValue;
          }

          return ascending
            ? aValue.localeCompare(bValue, undefined, {
                numeric: true,
                sensitivity: "base"
              })
            : bValue.localeCompare(aValue, undefined, {
                numeric: true,
                sensitivity: "base"
              });
        });

        tbody.append(...rows);
      });
    });
  });
</script>

<Base title={`Ranking de faltas dos ${totals.deputados} deputados`} description={`Ranking dos ${totals.deputados} deputados da Assembleia da República na XVII Legislatura, ordenados pelas faltas em reuniões plenárias. Dados oficiais, atualizados diariamente.`}>
	<h1>Ranking de faltas em plenário</h1>
	<p class="lede">{totals.deputados} deputados da {meta.legislatura} Legislatura, por ordem decrescente de faltas injustificadas.</p>

	<div class="stat-grid">
		<div class="stat"><div class="n">{totals.deputados}</div><div class="l">Deputados</div></div>
		<div class="stat"><div class="n">{totals.fi}</div><div class="l">Faltas injustificadas</div></div>
		<div class="stat"><div class="n">{totals.fj}</div><div class="l">Faltas justificadas</div></div>
		<div class="stat"><div class="n">{totals.f}</div><div class="l">Faltas não classificadas</div></div>
		<div class="stat"><div class="n">{totals.amp}</div><div class="l">Ausências em missão</div></div>
		<div class="stat"><div class="n" title={totals.percentage === null ? unavailableExplanation : undefined}>{formatAbsencePercentage(totals.percentage)}</div><div class="l">Faltas (%) · AR</div></div>
	</div>
	<AbsenceNote />
	<p>A percentagem da AR abrange todos os deputados deste ranking. Os valores da AR e dos grupos são calculados a partir das contagens somadas.</p>

	<h2>Principais motivos das faltas justificadas</h2>
	<ul class="motivo-list">
		{topMotivos.map((m) => (
			<li>
				<a href={`${base}/motivo/${m.slug}`}>{m.motivo}</a>
				<span class="motivo-count">{m.n}</span>
			</li>
		))}
		<li class="motivo-more"><a href={`${base}/motivos`}>Ver todos os motivos →</a></li>
	</ul>

	<h2>Por grupo parlamentar</h2>
	<div class="legend">
		<span><span class="badge FI">FI</span> Falta injustificada</span>
		<span><span class="badge FJ">FJ</span> Falta justificada</span>
		<span><span class="badge F">F</span> Falta não classificada</span>
		<span><span class="badge AMP">AMP</span> Ausência em missão parlamentar</span>
	</div>
	<table class="sortable">
		<thead>
			<tr>
				<th data-sort="text">GP</th>
				<th data-sort="number" class="num">Deputados</th>
				<th data-sort="number" class="num"><abbr title="Falta Injustificada">FI</abbr></th>
				<th data-sort="number" class="num"><abbr title="Falta Justificada">FJ</abbr></th>
				<th data-sort="number" class="num"><abbr title="Falta não classificada">F</abbr></th>
				<th data-sort="number" class="num"><abbr title="Ausência em Missão Parlamentar">AMP</abbr></th>
				<th data-sort="percentage" class="num">Faltas (%)</th>
			</tr>
		</thead>
		<tbody>
			{byParty(deputados).map((p) => (
				<tr>
					<td><a class="gp" data-p={p.gp} href={`${base}/gp/${slugify(p.gp)}`}>{p.gp}</a></td>
					<td class="num">{p.deputados}</td>
					<td class="num">{p.fi}</td>
					<td class="num">{p.fj}</td>
					<td class="num">{p.f}</td>
					<td class="num">{p.amp}</td>
					<td class="num" data-sort-value={p.percentage ?? ""} title={p.percentage === null ? unavailableExplanation : undefined}>{formatAbsencePercentage(p.percentage)}</td>
				</tr>
			))}
		</tbody>
	</table>

	{fqv.length > 0 && (
		<Fragment>
			<h2>Faltas ao quórum de votação</h2>
			<p class="lede">Deputados que estiveram presentes mas não participaram no número mínimo de votações do dia.</p>
			<table class="sortable">
				<thead>
					<tr>
						<th data-sort="text">Deputado</th>
						<th data-sort="text">GP</th>
						<th data-sort="number" class="num"><abbr title="Falta ao Quórum de Votação">FQV</abbr></th>
					</tr>
				</thead>
				<tbody>
					{fqv.map((d) => (
						<tr>
							<td><a href={`${base}/deputado/${d.bid}`}>{d.nome}</a></td>
							<td><span class="gp" data-p={d.gp}>{d.gp}</span></td>
							<td class="num">{d.falta_quorum_votacao}</td>
						</tr>
					))}
				</tbody>
			</table>
		</Fragment>
	)}

	<h2>Deputados</h2>
	<div class="legend">
		<span><span class="badge P">P</span> Presença</span>
		<span><span class="badge FJ">FJ</span> Falta justificada</span>
		<span><span class="badge FI">FI</span> Falta injustificada</span>
		<span><span class="badge F">F</span> Falta não classificada</span>
		<span><span class="badge AMP">AMP</span> Ausência em missão parlamentar</span>
	</div>
	<div class="filters" id="party-filters">
		<button data-gp="" aria-pressed="true">Todos</button>
		{parties.map((p) => (
			<button data-gp={p}>{p}</button>
		))}
	</div>

	<table id="deputados-table" class="sortable">
		<thead>
			<tr>
				<th data-sort="text">Deputado</th>
				<th data-sort="text">GP</th>
				<th data-sort="number" class="num">Reuniões</th>
				<th data-sort="number" class="num">P</th>
				<th data-sort="number" class="num">FJ</th>
				<th data-sort="number" class="num">FI</th>
				<th data-sort="number" class="num"><abbr title="Falta não classificada">F</abbr></th>
				<th data-sort="number" class="num">AMP</th>
				<th data-sort="percentage" class="num">Faltas (%)</th>
			</tr>
		</thead>
		<tbody>
			{ranked.map((d) => (
				<tr data-gp={d.gp}>
					<td><a href={`${base}/deputado/${d.bid}`}>{d.nome}</a></td>
					<td><span class="gp" data-p={d.gp}>{d.gp}</span></td>
					<td class="num">{d.total_reunioes}</td>
					<td class="num">{d.presencas}</td>
					<td class="num">{d.faltas_justificadas}</td>
					<td class="num">{d.faltas_injustificadas}</td>
					<td class="num">{d.f}</td>
					<td class="num">{d.missao_parlamentar}</td>
					<td class="num" data-sort-value={d.percentage ?? ""} title={d.percentage === null ? unavailableExplanation : undefined}>{formatAbsencePercentage(d.percentage)}</td>
				</tr>
			))}
		</tbody>
	</table>

	<script is:inline>
		(() => {
			const buttons = document.querySelectorAll("#party-filters button");
			const rows = document.querySelectorAll("#deputados-table tbody tr");
			buttons.forEach((btn) => {
				btn.addEventListener("click", () => {
					const gp = btn.getAttribute("data-gp") || "";
					buttons.forEach((b) => b.setAttribute("aria-pressed", b === btn ? "true" : "false"));
					rows.forEach((r) => {
						r.style.display = !gp || r.getAttribute("data-gp") === gp ? "" : "none";
					});
				});
			});
		})();
	</script>
</Base>
